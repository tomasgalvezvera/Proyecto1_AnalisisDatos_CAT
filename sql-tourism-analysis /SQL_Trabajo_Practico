## Parte 2 - ¿Qué cuentan nuestros datos? COUNT - SUM - AVG  - MIN  - MAX - GROUP BY  -HAVING
  
⦁	Obtener la cantidad total de Puntos CAT.
SELECT COUNT(*) AS cantidad_centros FROM cat;                   

⦁	¿Cuántos barrios hay?
SELECT COUNT(*) AS cantidad_barrios FROM barrios; 

⦁	¿Cuántos países aparecen?
SELECT COUNT(*) AS cantidad_paises FROM paises; 

⦁	Obtener la cantidad total de registros de visitas.
SELECT COUNT(*) AS cantidad_visitas FROM visitas; 

⦁	Obtener la cantidad total de pasajeros de esas visitas.
SELECT SUM(pasajeros) AS total_pasajeros FROM visitas;
 

⦁	¿"cantidad de visitas" y "cantidad de pasajeros" representan necesariamente lo mismo?
No. Cuando hablamos de Visitas es una consulta en centro cat. A diferencia de Pasajeros es la cantidad de personas que acompañaban a ese turista en esa consulta.
Por eso el total de pasajeros es mayor que el total de visitas.

    
⦁	Cantidad mínima, máxima y promedio de pasajeros por visita
SELECT MIN(pasajeros) AS minimo
FROM visitas;

SELECT MAX(pasajeros) AS maximo
FROM visitas;

SELECT AVG(pasajeros) AS promedio
FROM visitas;          

## Parte 3 – Frecuencias y algo más
  
⦁	¿Cuántos registros tiene cada país?
SELECT p.pais, COUNT(*) AS cantidad_visitas
FROM visitas v
JOIN paises p ON v.id_pais = p.id_pais
GROUP BY p.pais;

⦁	¿Cuántos pasajeros corresponden a cada país?
SELECT p.pais, SUM(v.pasajeros) AS total_pasajeros
FROM visitas v
JOIN paises p ON v.id_pais = p.id_pais
GROUP BY p.pais
ORDER BY total_pasajeros DESC;

⦁	Promedio de pasajeros por país
SELECT p.pais, AVG(v.pasajeros) AS promedio_pasajeros
FROM visitas v
JOIN paises p ON v.id_pais = p.id_pais
GROUP BY p.pais
ORDER BY promedio_pasajeros DESC;
           
⦁	Visitas en cada CAT
SELECT c.cat, COUNT(*) AS total_visitas
FROM visitas v
JOIN cat c ON v.id_cat = c.id_cat
GROUP BY c.cat
ORDER BY total_visitas DESC;

⦁	Pasajeros en cada CAT
SELECT c.cat, SUM(v.pasajeros) AS total_pasajeros
FROM visitas v
JOIN cat c ON v.id_cat = c.id_cat
GROUP BY c.cat
ORDER BY total_pasajeros DESC;
 
