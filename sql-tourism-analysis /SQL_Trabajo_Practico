## Parte 4 – (Modelo Relacional)
  
⦁	Mostrar cada Punto CAT junto con el barrio donde se encuentra.
SELECT c.cat, b.barrio
FROM cat c
JOIN barrios b ON c.id_barrio = b.id_barrio
ORDER BY c.cat ASC;  

⦁	Mostrar cada Punto CAT, su barrio y su comuna.
SELECT c.cat, b.barrio, co.comuna
FROM cat c
JOIN barrios b ON c.id_barrio = b.id_barrio
JOIN comunas co ON b.id_comuna = co.id_comuna
ORDER BY c.cat ASC;  

⦁	¿Cuántos CAT hay por comuna?
SELECT co.comuna, COUNT(*) AS cat_por_comuna
FROM cat c
JOIN barrios b ON c.id_barrio = b.id_barrio
JOIN comunas co ON b.id_comuna = co.id_comuna
GROUP BY co.comuna
ORDER BY cat_por_comuna DESC; 

⦁	¿Cuántas visitas recibió cada comuna?
SELECT co.comuna, COUNT(*) AS cantidad_visitas
FROM visitas v
JOIN comunas co ON v.id_comuna = co.id_comuna
GROUP BY co.comuna
ORDER BY cantidad_visitas DESC; 
 
⦁	¿Cuántos pasajeros corresponden a cada comuna?
SELECT co.comuna, SUM(v.pasajeros) AS cantidad_pasajeros
FROM visitas v
JOIN comunas co ON v.id_comuna = co.id_comuna
GROUP BY co.comuna
ORDER BY cantidad_pasajeros DESC;  

⦁	¿De qué país son las consultas?
SELECT co.comuna, p.pais, SUM(v.pasajeros) AS cant_pasajeros
FROM visitas v
JOIN comunas co ON v.id_comuna = co.id_comuna
JOIN paises p ON v.id_pais = p.id_pais
GROUP BY co.comuna, p.pais
ORDER BY co.comuna, cant_pasajeros DESC;    

⦁	Mostrar cuántos registros de visitas corresponden a cada combinación de país y Punto CAT.
SELECT p.pais, c.cat, COUNT(*) AS cant_visitas
FROM visitas v
JOIN paises p ON v.id_pais = p.id_pais
JOIN cat c ON v.id_cat = c.id_cat
GROUP BY p.pais, c.cat
ORDER BY cant_visitas DESC;

⦁	Mostrar los países que registran más de 100 visitas.
SELECT p.pais, COUNT(*) AS cant_visitas
FROM visitas v
JOIN paises p ON v.id_pais = p.id_pais
GROUP BY p.pais
HAVING COUNT(*) > 100
ORDER BY cant_visitas DESC;

## Parte 5 – CASE Crear una nueva columna llamada categoria que clasifique los países según la cantidad de visitas registradas:
⦁	"Baja" → menos de 20 visitas 
⦁	"Media" → entre 20 y 50 visitas 
⦁	"Alta" → más de 50 visitas. 
  
SELECT p.pais, COUNT(*) AS cantidad_visitas,
    CASE
    WHEN COUNT(*) < 20 THEN 'Baja'
    WHEN COUNT(*) BETWEEN 20 AND 50 THEN 'Media'
    ELSE 'Alta'
    END AS categoria
FROM visitas v
JOIN paises p ON v.id_pais = p.id_pais
GROUP BY p.pais 
ORDER BY cantidad_visitas DESC;



 





